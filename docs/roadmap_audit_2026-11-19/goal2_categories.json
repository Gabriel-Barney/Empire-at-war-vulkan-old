[
 {
  "op": "update",
  "collection": "meta",
  "doc_id": "backlog",
  "data": {
   "cats": {
    "parity-sim": {
     "label": "Movement and combat",
     "desc": "Pathing, Path Around, collision records, formations, stop and coast; attack approach, guard, scan range, fire trim, auto-engage, hidden targets, hard points (MOVEMENT, TACTICAL_COMBAT)"
    },
    "parity-ai": {
     "label": "Galactic rules and AI",
     "desc": "Planet ownership, auto-resolve, victory, galactic travel and setup rules; galactic AI plan choice, budget, production and timing against retail traces"
    },
    "tools-harness": {
     "label": "Tools, docs and workflow",
     "desc": "Parity harness, probe kits, build and test scripts; docs, the roadmap, agent workflow"
    },
    "re-research": {
     "label": "RE questions and Gabriel's runs",
     "desc": "Open questions for the binary that no group needs yet (docs/re only); playtests, in-game checks and release merges only Gabriel can do"
    },
    "render-ui": {
     "label": "Render and UI",
     "desc": "Renderer, shaders, front end, HUD, camera, video (audio has its own category)"
    },
    "audio": {
     "order": 55
    },
    "parity-combat": {
     "__delete__": true
    },
    "parity-campaign": {
     "__delete__": true
    },
    "docs-process": {
     "__delete__": true
    },
    "gabriel": {
     "__delete__": true
    }
   },
   "rules": [
    {
     "cat": "re-research",
     "gab": true
    },
    {
     "cat": "mod-system",
     "match": "\\bmods?\\b|workshop|thrawn|modc|\\bq6\\b"
    },
    {
     "cat": "perf",
     "match": "perf|\\bms a sim tick|tick budget|profil|bench|first battle tick|load time"
    },
    {
     "cat": "tools-harness",
     "match": "harness|probe kit|\\bkit\\b|parity tool|build script|regen_goldens|\\btools/|flaky|ctest"
    },
    {
     "cat": "tools-harness",
     "match": "roadmap|workflow|readme"
    },
    {
     "cat": "audio",
     "match": "\\baudio\\b|sfx|\\bmusic\\b|speech|\\bvo\\b|announcer|ambien|voice line"
    },
    {
     "cat": "parity-story",
     "match": "story (script|mission|campaign)|\\b[ue]m\\d\\d\\b|\\belim\\b"
    },
    {
     "cat": "parity-tactical-ai",
     "match": "skirmish ai|tactical ai|battle.?ai|land goal|space goal|guard_target|stand-?in|ai_plan_"
    },
    {
     "cat": "parity-ai",
     "match": "\\bai\\b|slicer|task.?force|plan choice|credits_at|proposal|desire"
    },
    {
     "cat": "parity-anim",
     "match": "walk_transition|locomot|\\bbike\\b|deploy|animation|secondaryfacing"
    },
    {
     "cat": "parity-sim",
     "match": "combat|weapon|hard ?point|attack|\\bguard|target|fire|projectile|damage|engage|scan range"
    },
    {
     "cat": "parity-sim",
     "match": "movement|collision|pathfind|path around|\\bpaths?\\b|formation|coast"
    },
    {
     "cat": "parity-rules",
     "match": "abilit|garrison|fighter|unit cap|spawn"
    },
    {
     "cat": "render-ui",
     "match": "render|shader|glow|visual|\\bui\\b|\\bmenu|camera|particle|\\bhud|results screen|holocron"
    },
    {
     "cat": "lua-data",
     "match": "\\blua\\b|\\bxml\\b|\\.ted\\b|field schema|map hint"
    },
    {
     "cat": "parity-ai",
     "match": "campaign|story|victory|galactic|planet|auto.?resolve|skirmish|retreat"
    },
    {
     "cat": "re-research",
     "match": "^\\s*\\[(re|probe)\\b"
    }
   ]
  }
 },
