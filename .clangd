# clangd config (2026-11-19). The compile database is this checkout's own clang tree, relative to this file, so each
# worktree reads its own tree although Claude Code starts clangd from the main checkout. Create or refresh it with
# build_agent.cmd clang all configure (seconds; no build). docs/BUILD.md, "C++ code intelligence".
CompileFlags:
  CompilationDatabase: build-wt-clang
