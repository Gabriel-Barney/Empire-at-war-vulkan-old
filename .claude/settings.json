  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -c \"import os,runpy,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),'tools','lint','check_string_literals.py'); sys.argv=[p,'--hook']; os.path.isfile(p) and runpy.run_path(p,run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python -I -c \"import os,runpy,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),'tools','worktree','worktree_tool.py'); sys.argv=[p,'link','--quiet']; os.path.isfile(p) and runpy.run_path(p,run_name='__main__')\""
          }
        ]
      }
    ]
